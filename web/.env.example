# SIGHTLINE laptop backend
PORT=8000
HOST=0.0.0.0

# Optional — descriptor enrichment + recall phrasing (separate from vision)
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional — spoken leave-behind / recall alerts
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Demo ANS domain for verified agents
ANS_TEAM_DOMAIN=sightline.local

# Local vision (COCO-SSD). browser = WebGL in Mission Control (smooth default)
VISION_MODE=browser
VISION_EVERY_N_FRAMES=8
VISION_MIN_SCORE=0.35
PREVIEW_MAX_FPS=12

# Gemini enrichment cadence (does not block detection)
GEMINI_EVERY_N_VISION=6

# Optional NVIDIA LocateAnything worker (CUDA GPU required remotely)
# See https://research.nvidia.com/labs/lpr/locate-anything/
# Expects POST {base}/detect with { image_base64, categories }
LOCATE_ANYTHING_URL=
LOCATE_ANYTHING_TIMEOUT_MS=8000
LOCATE_ANYTHING_MIN_INTERVAL_MS=8000
# When LA returns 0, optionally fall back to local COCO (off by default)
COCO_FALLBACK=false

LEAVE_BEHIND_METERS=12
LEAVE_BEHIND_ABSENT_MS=8000
