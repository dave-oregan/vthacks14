# SIGHTLINE laptop backend
PORT=8000
HOST=0.0.0.0

# Optional — richer object descriptors + scene reasoning
GEMINI_API_KEY=
# Optional override (default tries gemini-2.5-flash, then gemini-3.6-flash, …)
GEMINI_MODEL=

# Optional — spoken leave-behind / recall alerts
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Demo ANS domain for verified agents
ANS_TEAM_DOMAIN=sightline.local

# Vision
VISION_EVERY_N_FRAMES=4
VISION_MIN_SCORE=0.4
GEMINI_EVERY_N_VISION=3
PREVIEW_MAX_FPS=5
LEAVE_BEHIND_METERS=12
LEAVE_BEHIND_ABSENT_MS=8000
