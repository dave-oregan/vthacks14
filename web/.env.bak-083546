# SIGHTLINE laptop backend — local dev (Komal / WSL LocateAnything worker)
PORT=8000
HOST=0.0.0.0

# --- Vision: NVIDIA LocateAnything via tools/la_worker.py -------------------
# server = run server-side detect (required for LocateAnything to be called)
# NOTE: each call reloads ~5.2GB into VRAM -> ~15s per detection.
#       Set VISION_MODE=browser to go back to smooth in-browser COCO.
VISION_MODE=server
LOCATE_ANYTHING_URL=http://localhost:8199
LOCATE_ANYTHING_TIMEOUT_MS=60000
VISION_EVERY_N_FRAMES=8
VISION_MIN_SCORE=0.35
PREVIEW_MAX_FPS=12

# --- Keys (fill in) --------------------------------------------------------
GEMINI_API_KEY=
GEMINI_EVERY_N_VISION=6
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- GoDaddy ANS -----------------------------------------------------------
ANS_TEAM_DOMAIN=sightline.local
GODADDY_API_KEY=
GODADDY_API_SECRET=

# --- Twilio (Guardian sim) — leave blank to no-op --------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# --- Mission tuning --------------------------------------------------------
LEAVE_BEHIND_METERS=12
LEAVE_BEHIND_ABSENT_MS=8000

# Atlas connection string - paste it after the = (nobody but you needs to see it)
MONGO_URI=mongodb+srv://ktumma14_db_user:x9BxMQy6CREaxqMn@cluster0.6tlcvcy.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Speech-to-text (wearable + phone mic). Uses the ElevenLabs key above.
STT_ENABLED=1
ELEVENLABS_STT_MODEL=scribe_v1
# STT_LANGUAGE_CODE=eng
# Set to 1 to let a spoken question trigger recall automatically:
STT_AUTO_RECALL=0
