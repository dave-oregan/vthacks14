# ─────────────────────────────────────────────────────────────
# SIGHTLINE // SIDEKICK — environment
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real keys.
# ─────────────────────────────────────────────────────────────

# HokieAI gateway base URL (OpenAI-compatible chat completions host).
# The app calls:  POST {HOKIEAI_BASE_URL}/chat/completions
# TODO: confirm the exact base URL from the HokieAI sponsor docs/booth.
# Example shape: https://hokie.ai.vt.edu/api/v1   (placeholder — verify!)
HOKIEAI_BASE_URL=

# Bearer token / API key issued for the hackathon.
# TODO: paste the key provided by the HokieAI sponsor.
HOKIEAI_API_KEY=

# Model name to request, e.g. "gpt-4o-mini", "claude-…", etc.
# TODO: confirm which model identifiers the gateway exposes.
HOKIEAI_MODEL=

# Optional overrides (usually leave unset)
# HOKIEAI_TIMEOUT_MS=12000
# HOKIEAI_CHAT_PATH=/chat/completions   # appended to HOKIEAI_BASE_URL

# ─────────────────────────────────────────────────────────────
# GEMINI — interim provider, used when HokieAI creds aren't set.
# Provider chain: HokieAI → Gemini → local fallback.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest   # optional override
# GEMINI_TIMEOUT_MS=12000

# ─────────────────────────────────────────────────────────────
# DEV FALLBACK
# If no provider credentials are set (or all fail), /api/analyze
# uses a deterministic built-in generator (development/demo only).
# To FORCE the fallback even when keys exist: SIDEKICK_FORCE_FALLBACK=true
# ─────────────────────────────────────────────────────────────
# SIDEKICK_FORCE_FALLBACK=false
